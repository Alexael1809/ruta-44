# ==============================================================================
# RUTA 44 - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (SUPABASE POSTGRESQL)
# ------------------------------------------------------------------------------
# Supabase proporciona la cadena de conexión en:
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Ejemplo (Direct Connection con SSL):
# postgresql://postgres:[TU-PASSWORD]@db.[TU-PROYECTO-ID].supabase.co:5432/postgres?sslmode=require
#
# Ejemplo (Supabase Pooler en puerto 5432 - Session Mode):
# postgresql://postgres.[TU-PROYECTO-ID]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO_ID].supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. SERVIDOR API (EXPRESS)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. FRONTEND (VITE / REACT)
# ------------------------------------------------------------------------------
BASE_PATH=/
API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. AUTENTICACIÓN (CLERK)
# ------------------------------------------------------------------------------
# Claves desde https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# 5. CREDENCIALES ADMIN MASTER (alexaelperdomo2410@gmail.com)
# ------------------------------------------------------------------------------
MASTER_INITIAL_PASSWORD=Ruta44AdminMaster_2026!
